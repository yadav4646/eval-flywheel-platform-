# Copy to .env and fill in. Everything also runs keyless with --mock / MOCK=1.

# OpenAI: the agent, the LLM judge, curation SQL drafts and embeddings.
OPENAI_API_KEY=

# Braintrust: production traces, experiments, the golden dataset.
# Without it, traces go to traces/*.jsonl and evals run locally (noSendLogs).
BRAINTRUST_API_KEY=
BRAINTRUST_PROJECT=SQL Analyst

# Optional model overrides (defaults live in flywheel/config.ts).
# AGENT_MODEL=gpt-5.4-mini
# JUDGE_MODEL=gpt-5.4
# EMBEDDING_MODEL=text-embedding-3-small
